# Merged single-port deployment (recommended): leave empty so the
# browser calls the same origin that served the page (port 8080).
# VITE_API_BASE_URL=

# Separate dev servers (Vite on :5173 + Spring on :8080):
# VITE_API_BASE_URL=http://localhost:8080

# Separate production API on another domain:
# VITE_API_BASE_URL=https://your-backend-domain.example.com
